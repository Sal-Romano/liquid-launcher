<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the launcher draw over every app (volume pill, start cover, Home curtain) and watch the
     volume change. No screen content is read. (Key filtering stays declared but Fire OS never
     hands volume or Home keys to a filter; see VolumeService and HomeKeyWatch.) -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/volume_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.android.systemui"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100" />
