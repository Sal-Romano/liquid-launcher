<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Wallpapers: /sdcard/Pictures/Wallpapers through MediaStore. Sideloaded, so grant over adb:
         adb shell pm grant dev.sal.glass android.permission.READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- A launcher must see every launchable app (package visibility filtering, API 30+). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The network indicator in the top right (both are normal permissions, granted at install). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The drop endpoint: a small HTTP server on the home network that receives files to show. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Glass">
        <!-- usesCleartextTraffic: the Roku soundbar's control port (8060) is plain HTTP on the LAN. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Declared as a HOME app too, so Home on Fire launches it with CATEGORY_HOME
                 and Back inside it stops here instead of falling through to Amazon's home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The volume keys, system-wide: fewer levels and the launcher's own pill. Enabled over
             adb (see VolumeService); never on by itself. -->
        <service
            android:name=".volume.VolumeService"
            android:exported="true"
            android:label="Glass volume"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/volume_service" />
        </service>
    </application>

</manifest>
